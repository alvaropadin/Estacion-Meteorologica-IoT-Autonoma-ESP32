#include <WiFi.h>
#include <esp_now.h>
#include "esp_wifi.h"

#include <DHT.h>
#include <Wire.h>
#include <Adafruit_BMP280.h>

Adafruit_BMP280 bmp;

// =========================================================
// CONFIGURACIÓN DE SENSORES
// =========================================================

#define DHT11_PIN 19
#define UV_SENSOR_PIN 34

DHT dht(DHT11_PIN, DHT11);

// =========================================================
// CONFIGURACIÓN ESP-NOW
// =========================================================

// MAC de la ESP32 receptora
uint8_t receptorMAC[] = {
  0x20, 0x50, 0x0D, 0x32, 0xA8, 0x30
};

// Estructura que vamos a enviar
struct DatosMeteorologicos {
  float temperatura;
  float humedad;
  float presion;
  float uvIndex;
};

// Variable donde almacenaremos los datos
DatosMeteorologicos datos;

// =========================================================
// CALLBACK DE ENVÍO ESP-NOW
// =========================================================

void onDataSent(const wifi_tx_info_t *info, esp_now_send_status_t status) {

  Serial.print("Estado del envio: ");

  if (status == ESP_NOW_SEND_SUCCESS) {
    Serial.println("OK");
  } else {
    Serial.println("ERROR");
  }
}

// =========================================================
// SETUP
// =========================================================

void setup() {

  Serial.begin(115200);
  delay(1000);

  // ---------------------------------------------------------
  // DHT11
  // ---------------------------------------------------------

  dht.begin();

  // ---------------------------------------------------------
  // ADC SENSOR UV
  // ---------------------------------------------------------

  analogSetPinAttenuation(UV_SENSOR_PIN, ADC_11db);

  // ---------------------------------------------------------
  // BMP280
  // ---------------------------------------------------------

  if (!bmp.begin(0x76)) {
    Serial.println("No se ha encontrado el BMP280");
    while (1);
  }

  // ---------------------------------------------------------
  // WIFI / ESP-NOW
  // ---------------------------------------------------------

  WiFi.mode(WIFI_STA);

  // Las dos ESP32 deben estar en el mismo canal
  esp_wifi_set_channel(1, WIFI_SECOND_CHAN_NONE);

  Serial.println();
  Serial.println("=====================================");
  Serial.println("     ESTACION METEOROLOGICA");
  Serial.println("=====================================");

  Serial.print("MAC emisora: ");
  Serial.println(WiFi.macAddress());

  // Inicializar ESP-NOW
  if (esp_now_init() != ESP_OK) {
    Serial.println("Error al iniciar ESP-NOW");
    return;
  }

  // Registrar callback de envio
  esp_now_register_send_cb(onDataSent);

  // ---------------------------------------------------------
  // REGISTRAR ESP32 RECEPTORA
  // ---------------------------------------------------------

  esp_now_peer_info_t peerInfo = {};

  memcpy(peerInfo.peer_addr, receptorMAC, 6);

  peerInfo.channel = 1;
  peerInfo.encrypt = false;

  if (esp_now_add_peer(&peerInfo) != ESP_OK) {
    Serial.println("Error al registrar receptor");
    return;
  }

  Serial.println("Receptor registrado correctamente");

  Serial.println("-------------------------------------");
  Serial.println("DHT11 -> GPIO19");
  Serial.println("GUVA-S12SD -> GPIO34");
  Serial.println("BMP280 -> I2C");
  Serial.println("-------------------------------------");

  delay(2000);
}

// =========================================================
// LOOP
// =========================================================

void loop() {

  // =========================================================
  // 1. SENSOR UV
  // =========================================================

  int sensorValue = analogRead(UV_SENSOR_PIN);

  float voltage = (sensorValue * (3.3 / 4095.0)) * 2.0;

  float uvIndex = voltage / 0.1;

  if (uvIndex < 0) {
    uvIndex = 0;
  }

  // Guardamos el dato en la estructura
  datos.uvIndex = uvIndex;

  Serial.print("UV -> ADC: ");
  Serial.print(sensorValue);

  Serial.print(" | Voltaje: ");
  Serial.print(voltage, 2);

  Serial.print(" V | Indice UV: ");
  Serial.println(uvIndex, 1);

  // =========================================================
  // 2. DHT11
  // =========================================================

  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();

  // =========================================================
  // 3. BMP280
  // =========================================================

  float presion = bmp.readPressure() / 100.0F;

  // =========================================================
  // 4. COMPROBAR DHT11
  // =========================================================

  if (isnan(temperature) || isnan(humidity)) {

    Serial.println("DHT -> Error: No se pudo leer el sensor");

    // Indicamos valores no válidos
    datos.temperatura = NAN;
    datos.humedad = NAN;

  } else {

    datos.temperatura = temperature;
    datos.humedad = humidity;

    Serial.print("DHT -> Temperatura: ");
    Serial.print(temperature, 1);

    Serial.print(" °C | Humedad: ");
    Serial.print(humidity, 1);

    Serial.println(" %");
  }

  // =========================================================
  // 5. PRESIÓN
  // =========================================================

  datos.presion = presion;

  Serial.print("BMP280 -> Presion: ");
  Serial.print(presion, 1);
  Serial.println(" hPa");

  // =========================================================
  // 6. ENVIAR DATOS POR ESP-NOW
  // =========================================================

  esp_err_t resultado = esp_now_send(
    receptorMAC,
    (uint8_t *)&datos,
    sizeof(datos)
  );

  if (resultado == ESP_OK) {

    Serial.println("Datos enviados por ESP-NOW");

  } else {

    Serial.println("Error al enviar los datos");
  }

  // =========================================================
  // SEPARADOR
  // =========================================================

  Serial.println("-------------------------------------");

  delay(2000);
}
